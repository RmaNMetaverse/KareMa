# ---- KareMa configuration -------------------------------------------------
# Copy this file to ".env" (same folder) and edit before first start.

# Port you will open in the browser -> http://localhost:8080
KAREMA_PORT=8080

# Database (only used inside docker, no need to expose it)
POSTGRES_USER=karema
POSTGRES_PASSWORD=karema_dev_password
POSTGRES_DB=karema

# IMPORTANT: change this to a long random string for production.
JWT_SECRET=please-change-me-in-production

# The first admin account, created automatically on first start.
ADMIN_EMAIL=admin@karema.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrator

# Max attachment size, in megabytes
MAX_UPLOAD_MB=100
