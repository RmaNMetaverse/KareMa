# ---- KareMa configuration -------------------------------------------------
# Copy this file to ".env" (same folder) and edit before first start.
#
# If a value contains a dollar sign, wrap it in single quotes:
#     ADMIN_PASSWORD='M0$e$2034'
# Unquoted, Docker Compose reads $e as a variable and drops it, so the
# password the container receives is not the one you typed.

# Port you will open in the browser -> http://localhost:8080
KAREMA_PORT=8080

# Which host interface to publish that port on. Leave as-is for a direct install;
# set to 127.0.0.1 when nginx/Caddy on the host proxies to KareMa.
KAREMA_BIND=0.0.0.0

# Where KareMa lives in the URL. "/" means http://host:8080/ ,
# "/KareMa/" means http://host/KareMa/ behind a reverse proxy.
# Changing this needs a rebuild: docker compose up -d --build web
BASE_PATH=/

# Database (only used inside docker, no need to expose it)
POSTGRES_USER=karema
POSTGRES_PASSWORD=karema_dev_password
POSTGRES_DB=karema

# IMPORTANT: change this to a long random string for production.
JWT_SECRET=please-change-me-in-production

# The first admin account, created automatically on first start.
ADMIN_EMAIL=admin@karema.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrator

# Max attachment size, in megabytes
MAX_UPLOAD_MB=100
